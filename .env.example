# MC Plan Skin 本地开发环境变量示例。仅包含本地占位值，不含任何真实密钥。
SKIN_RUN_MODE=standalone
SKIN_ENV=development
SKIN_LOG_LEVEL=info
SKIN_API_HOST=127.0.0.1
SKIN_API_PORT=4000
# 本地端口选用 15432/16379，避免与本机其他项目常用的 5432/6379 冲突
SKIN_DATABASE_URL=postgresql://mc_plan_skin:local-only@127.0.0.1:15432/mc_plan_skin
SKIN_REDIS_URL=redis://127.0.0.1:16379
SKIN_CANDIDATE_STORAGE_ROOT=./data/candidates
SKIN_CONVERSATION_RETENTION_DAYS=30
SKIN_CANDIDATE_RETENTION_HOURS=24
# 仅 official 模式需要；standalone 忽略
SKIN_OFFICIAL_CORE_BASE_URL=
# Web 同源代理转发目标（Next rewrites /api/* → 该地址）
SKIN_API_PROXY_TARGET=http://127.0.0.1:4000
