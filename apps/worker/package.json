{
  "name": "@mc-plan/skin-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "check:full": "pnpm check && pnpm test:integration"
  },
  "dependencies": {
    "@mc-plan/skin-config": "workspace:*",
    "@mc-plan/skin-core": "workspace:*",
    "bullmq": "6.3.11",
    "dotenv": "18.0.4",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/redis": "12.1.0",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
