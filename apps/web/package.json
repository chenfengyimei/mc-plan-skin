    "test:integration": "echo 'web integration covered by root Playwright' && exit 0"
  },
  "dependencies": {
    "@mc-plan/skin-core": "workspace:*",
    "next": "16.3.8",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@mc-plan/skin-test-fixtures": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
