{
  "name": "@mc-plan/skin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:e2e": "node scripts/start-e2e.mjs",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "migration:validate": "pnpm prisma:validate && node scripts/verify-migrations.mjs",
    "migration:deploy": "node scripts/require-database-url.mjs && prisma migrate deploy --config prisma7.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:e2e && pnpm migration:validate && pnpm build",
    "check:full": "pnpm check && pnpm test:integration"
  },
  "dependencies": {
    "@mc-plan/skin-config": "workspace:*",
    "@mc-plan/skin-contracts": "workspace:*",
    "@mc-plan/skin-core": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.4",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
